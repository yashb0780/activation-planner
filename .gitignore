# Private files: anything that should stay off the public repo (a real
# customer, account data, an unannounced demo). Never committed. The public
# build works without them.
config/private-*
examples/private-*
src/data/private-*
# Secrets (API keys, passwords) and local-only settings. Never committed.
.env*
.claude/launch.json
.DS_Store
node_modules
dist
